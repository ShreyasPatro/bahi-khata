# Copy to .env.local and fill in. .env.local is ignored by Git.
#
# Both values are PUBLIC and ship to the browser. Find them in the Supabase dashboard:
# Project Settings -> API (URL) and API Keys (publishable key, or legacy "anon" key).
#
# NEVER put the service-role / secret key here, or in any VITE_* variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
